# 复制本文件为 .env 并填入真实值（.env 已被 .gitignore 排除、且被 .claude/settings.json 禁止读取）
# 用法：copy .env.example .env  然后编辑 .env

# ── LLM 后端选择 ──────────────────────────────────────────────
# provider：anthropic（默认，Claude 系）/ openai（GPT 或任何 OpenAI 兼容中转站）
# AWARD_AUDIT_PROVIDER=openai

# 密钥（两种 provider 都用这个变量名）
ANTHROPIC_API_KEY=

# 中转站/代理接入地址（用官方直连时留空）。两种 provider 都读这个（或 ANTHROPIC_BASE_URL）：
# anthropic：填到 /v1 之前，如 https://relay.com（SDK 自补 /v1/messages）
# openai：填带或不带 /v1 都行，如 https://relay.com/v1（SDK 自补 /chat/completions）
# AWARD_AUDIT_BASE_URL=

# 模型（按 provider 填对应模型名；不填则 anthropic→claude-opus-4-8，openai→gpt-4o）
# AWARD_AUDIT_MODEL=gpt-4o
# AWARD_AUDIT_MODEL_FAST=gpt-4o-mini

# 视觉抽取（图片名单）：默认关。纯文本模型（deepseek 等）不支持图片输入，开了会报错。
# 用支持视觉的模型（gpt-4o、qwen-vl 等）时设为 1，图片型名单才会自动抽取：
# AWARD_AUDIT_VISION=1

# ── 仅 anthropic 用 ───────────────────────────────────────────
# 1M 上下文：部分中转站强制要求带此 beta header，否则 400。设为 1 启用：
# AWARD_AUDIT_1M=1
# AWARD_AUDIT_1M_BETA=context-1m-2025-08-07

# ── 其它可选覆盖 ──────────────────────────────────────────────
# AWARD_AUDIT_REFERENCE=   # 参照三件套目录（默认 reference/ 回退 ../评奖信息核查/）
# AWARD_AUDIT_DB=          # 台账库路径（默认 项目根/award_audit.db）
# AWARD_AUDIT_PORT=        # daemon 端口（默认 7438）
